FLASK_ENV=development
FLASK_APP=app.py
FLASK_DEBUG=True

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/remote_sensing
MONGODB_URL=mongodb://localhost:27017/remote_sensing

# Security
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here

# API
API_TIMEOUT=30
API_MAX_UPLOAD_SIZE=104857600
